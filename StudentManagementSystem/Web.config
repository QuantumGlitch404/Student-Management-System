<?xml version="1.0" encoding="utf-8"?>
<!--
  Student Information and Academic Management System (ASP.NET Web Forms / .NET Framework 4.8)

  INTEGRATION SWITCHES: every external service is disabled until credentials are set.
  See Documentation/04_Integration_Guide.md for which key each feature needs.
  SECURITY: production secrets are applied via deployment (environment vars / IIS
  config transform), never committed - see Documentation/07_Deployment_Guide.md.
-->
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!-- Classic inline client validation: unobtrusive mode needs a ScriptResourceMapping
         for jQuery and would break offline installs. Server validation still runs. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>

    <add key="AppTitle" value="Student Management System"/>
    <add key="AppShortName" value="SMS"/>

    <!-- Email (OTP + notifications): any SMTP works (Brevo free 300/day, Gmail app-password, ...) -->
    <add key="Email:Enabled" value="false"/>
    <add key="Email:FromAddress" value="noreply@sms.edu"/>
    <add key="Email:FromName" value="Student Management System"/>
    <add key="Email:SmtpHost" value="smtp-relay.brevo.com"/>
    <add key="Email:SmtpPort" value="587"/>
    <add key="Email:EnableSsl" value="true"/>
    <add key="Email:User" value=""/>
    <add key="Email:Password" value=""/>

    <!-- SMS OTP adapter (Fast2SMS). Falls back to email when blank. -->
    <add key="Sms:Provider" value="Fast2SMS"/>
    <add key="Sms:ApiKey" value=""/>
    <add key="Sms:Route" value="q"/>

    <!-- OTP policy -->
    <add key="Otp:ExpiryMinutes" value="10"/>
    <add key="Otp:Length" value="6"/>
    <add key="Otp:MaxAttempts" value="3"/>
    <add key="Otp:ResendCooldownSeconds" value="60"/>

    <!-- Sessions / lockout -->
    <add key="MinPasswordLength" value="8"/>
    <add key="SessionTimeoutMinutes" value="60"/>
    <add key="Login:LockoutAfterFailures" value="5"/>
    <add key="Login:LockoutMinutes" value="15"/>

    <!-- Google OAuth (server-side code flow + tokeninfo validation) -->
    <add key="GoogleAuth:Enabled" value="false"/>
    <add key="GoogleAuth:ClientId" value=""/>
    <add key="GoogleAuth:ClientSecret" value=""/>

    <!-- Razorpay (use TEST-mode keys; live keys only in production deployment) -->
    <add key="Razorpay:Enabled" value="false"/>
    <add key="Razorpay:KeyId" value=""/>
    <add key="Razorpay:KeySecret" value=""/>
    <add key="Razorpay:WebhookSecret" value=""/>

    <!-- Web Push (browser VAPID), optional -->
    <add key="Push:Enabled" value="false"/>
    <add key="Push:VapidSubject" value="mailto:admin@sms.edu"/>
    <add key="Push:VapidPublicKey" value=""/>
    <add key="Push:VapidPrivateKey" value=""/>

    <!-- Chatbot LLM (optional; database FAQ fallback always available) -->
    <add key="Chatbot:Provider" value="Groq"/>
    <add key="Chatbot:GroqApiKey" value=""/>
    <add key="Chatbot:GroqModel" value="llama-3.3-70b-versatile"/>
    <add key="Chatbot:GeminiApiKey" value=""/>
    <add key="Chatbot:GeminiModel" value="gemini-2.0-flash"/>
    <add key="Chatbot:MaxChars" value="240"/>

    <!-- Offline AI assistant. The installer ships AI\model and AI\runtime next
         to the site folder; the service starts the runtime lazily on first use. -->
    <add key="Ai:Enabled" value="true"/>
    <add key="Ai:Directory" value=""/>
    <add key="Ai:ModelPath" value=""/>
    <add key="Ai:RuntimePath" value=""/>
    <add key="Ai:Port" value="8137"/>
    <add key="Ai:Threads" value="0"/>

    <!-- Base URL used in emails / OAuth redirect / webhooks -->
    <add key="App:BaseUrl" value="http://localhost:49915/"/>
  </appSettings>

  <connectionStrings>
    <!-- SQL Server (mandated). Dev default = LocalDB created by Database\01_CreateDatabase.sql -->
    <add name="DefaultConnection"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB; Initial Catalog=StudentSMS; Integrated Security=True; MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <system.web>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" defaultUrl="~/Default.aspx" name="SMSCookie" timeout="60" slidingExpiration="true" protection="All" requireSSL="false" path="/" cookieless="UseCookies"/>
    </authentication>
    <authorization>
      <deny users="?"/>
    </authorization>
    <!-- Validation/decryption keys generated at project time; regenerate per environment. -->
    <machineKey validationKey="1757C6831B0DE514DCD7A6D07F52ECE7E424CE3D8BF971101D29AA8A5C92296C"
                decryptionKey="7A55B65C9E8BCDBA327A2451AF11F635"
                validation="HMACSHA256" decryption="AES"/>

    <compilation debug="true" targetFramework="4.8"/>

    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" enableVersionHeader="false" maxRequestLength="10240"/>
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax"/>
    <sessionState mode="InProc" timeout="60" cookieless="UseCookies"/>

    <customErrors mode="RemoteOnly" defaultRedirect="~/Account/Error.aspx">
      <error statusCode="404" redirect="~/Account/Error.aspx?code=404" />
    </customErrors>

    <pages controlRenderingCompatibilityVersion="4.8" validateRequest="true">
      <!-- Needed by inline expressions in Site.Master / .aspx markup:
           the generated classes do not see the code-behind's using directives. -->
      <namespaces>
        <add namespace="StudentManagementSystem.Lib"/>
        <add namespace="StudentManagementSystem.Data"/>
      </namespaces>
    </pages>
  </system.web>

  <!-- <location> must be a direct child of <configuration>, never inside <system.web>.
       Account pages are public (login/signup/verify/reset); everything else requires auth. -->
  <location path="Account">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>

  <!-- Liveness probe and one-click unsubscribe: neither returns private data. -->
  <location path="Handlers/Health.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Handlers/Unsubscribe.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>

  <!-- Machine-to-machine endpoints: the caller has no auth cookie. Both verify
       their own credentials (HMAC signature / OAuth state + code) before changing
       anything, so anonymous access here does not expose data. -->
  <location path="Handlers/RazorpayWebhook.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Handlers/GoogleOAuth.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>

  <!-- Anonymous appearance cookie: the login/signup pages let visitors pick a
       theme and text size before they have an account, so this one handler must
       be reachable without a forms ticket. It stores no user data when
       unauthenticated (cookie mirror only). -->
<location path="Handlers/Preferences.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Static content must be publicly accessible for unauthenticated users
       (login, signup, verify pages) to load styles, scripts, fonts, icons. -->
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/css">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/fonts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/icons">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/js">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/vendor">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content/icons/sprite.svg">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="UrlRoutingModule-4.0" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
    </modules>
    <handlers>
      <!-- Google OAuth callback - extensionless URL mapped to ASP.NET handler -->
      <add name="GoogleCallback" path="Account/GoogleCallback" verb="GET" type="System.Web.UI.PageHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Razorpay webhook - ensure it's handled by ASP.NET -->
      <add name="RazorpayWebhook" path="Handlers/RazorpayWebhook.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Google OAuth handler -->
      <add name="GoogleOAuth" path="Handlers/GoogleOAuth.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Health check -->
      <add name="Health" path="Handlers/Health.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Unsubscribe -->
      <add name="Unsubscribe" path="Handlers/Unsubscribe.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Preferences -->
      <add name="Preferences" path="Handlers/Preferences.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Ticker feed -->
      <add name="TickerFeed" path="Handlers/TickerFeed.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Export handlers -->
      <add name="Export" path="Handlers/Export.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="ExportCsv" path="Handlers/ExportCsv.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Calendar ICS -->
      <add name="CalendarIcs" path="Handlers/CalendarIcs.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Chat handler -->
      <add name="ChatHandler" path="Handlers/ChatHandler.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Notify handlers -->
      <add name="NotifyAction" path="Handlers/NotifyAction.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="NotifyBadge" path="Handlers/NotifyBadge.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="NotifyGo" path="Handlers/NotifyGo.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="NotifyList" path="Handlers/NotifyList.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Push handlers -->
      <add name="PushSubscribe" path="Handlers/PushSubscribe.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Settings handler -->
      <add name="SettingsHandler" path="Handlers/Settings.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Online test action -->
      <add name="OnlineTestAction" path="Handlers/OnlineTestAction.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- AI handlers -->
      <add name="AiChat" path="Handlers/AiChat.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="AiConversations" path="Handlers/AiConversations.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <add name="AiStatus" path="Handlers/AiStatus.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Receipt handler -->
      <add name="Receipt" path="Handlers/Receipt.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- Ack announcement -->
      <add name="AckAnnouncement" path="Handlers/AckAnnouncement.ashx" verb="POST" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
      <!-- MyData handler -->
      <add name="MyData" path="Handlers/MyData.ashx" verb="GET" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
    </handlers>
    <staticContent>
      <!-- A rebuilt site must never serve an old stylesheet from the browser
           cache while the HTML is new. Versioned URLs plus this header make
           every deploy deterministic. -->
      <clientCache cacheControlMode="DisableCache" cacheControlCustom="no-cache, must-revalidate" />
      <!-- remove-then-add: IIS/IIS Express already maps some of these, and a plain
           <add> would fail with "duplicate collection entry" (HTTP 500.19). -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>

